{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,  // Habilite esta flag
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "sourceMap": true
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx", "./main.ts"],
  "exclude": ["node_modules"]
}
